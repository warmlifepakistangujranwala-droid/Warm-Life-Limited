# ============================================================
# Warm Life Ltd — Local Environment Variables
# Copy this file to `.env.local` and add real values locally.
# Never commit `.env.local` to Git.
# ============================================================

# Supabase public project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase public anonymous key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key
# Do not expose this value in client-side code.
SUPABASE_SERVICE_ROLE_KEY=

# Public website URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
